# ---------------------------------------------------------------------------
# PayLens — files that are not part of the repository.
#
# Two audiences:
#   • GitHub  — the source, and nothing that is local state or a secret.
#   • Vercel  — only the frontend; see .vercelignore for that side.
# ---------------------------------------------------------------------------

# --- Dependencies -----------------------------------------------------------
node_modules
.pnp
.pnp.js

# --- Build output -----------------------------------------------------------
dist
dist-ssr
build
*.local
*.tsbuildinfo

# --- Logs -------------------------------------------------------------------
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# --- Environment and secrets ------------------------------------------------
# Every value can also come from the real environment, which is what a
# deployment should use. Never commit a populated .env.
.env
.env.local
.env.*.local
backend/.env
*.pem
*.key

# --- Local database ---------------------------------------------------------
# The development dataset. It is generated by `php backend/bin/setup.php`.
backend/storage/*.sqlite
backend/storage/*.sqlite-journal
backend/storage/*.sqlite-wal
backend/storage/*.sqlite-shm
backend/storage/*.bak*

# --- Vercel -----------------------------------------------------------------
.vercel

# --- Caches -----------------------------------------------------------------
.vite
.cache
.phpunit.result.cache

# --- Screenshots produced by the local check scripts -------------------------
_check-dashboard.png
_shot-schedules.png

# --- Editor -----------------------------------------------------------------
# The project's own settings are welcome; personal ones are not.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
