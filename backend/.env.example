# ---------------------------------------------------------------------------
# PayLens backend — environment template
#
# Copy to backend/.env and adjust. Never commit a real .env.
# Every value can also be supplied as a real environment variable, which is
# what a container or PaaS deployment should do.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:8080
# Demo affordances (one-click role login, seeded accounts). Turn this OFF in
# production: the demo-login endpoint refuses to run when APP_ENV=production.
APP_DEMO_MODE=true
APP_TIMEZONE=UTC
# Vercel enables this automatically by default. It applies migrations and
# seeds only an empty PayLens schema; existing data is left alone.
APP_AUTO_SETUP=false

# --- Database ---------------------------------------------------------------
# PostgreSQL (recommended for Vercel/Neon). DATABASE_URL may be the same
# database used by another app; DB_SCHEMA keeps PayLens fully isolated:
#   DB_DRIVER=pgsql
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
#   DB_SCHEMA=paylens
#
# MySQL 8.x is also supported:
#   DB_DRIVER=mysql
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_DATABASE=paylens
#   DB_USERNAME=paylens
#   DB_PASSWORD=change-me
#
# SQLite is the zero-setup development fallback (no server required):
DB_DRIVER=sqlite
DATABASE_URL=
DB_SCHEMA=paylens
DB_DATABASE=storage/paylens.sqlite
DB_USERNAME=
DB_PASSWORD=

# --- Sessions ---------------------------------------------------------------
# Absolute session lifetime and idle timeout, in seconds.
SESSION_ABSOLUTE_SECONDS=43200
SESSION_IDLE_SECONDS=1800
# Set to true when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Lax for a same-origin setup. When the frontend and the API are on
# different hosts (for example the frontend on Vercel and the API on a PHP
# host), set this to None and SESSION_COOKIE_SECURE to true — the browser
# only sends a cross-site cookie under those two settings, and only over
# HTTPS.
SESSION_COOKIE_SAMESITE=Lax

# --- Security ---------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
PASSWORD_MIN_LENGTH=12
# Comma-separated list of origins allowed to call the API cross-origin.
# Leave empty for same-origin only (the recommended setup).
CORS_ORIGINS=

# --- Payroll ----------------------------------------------------------------
PAYROLL_DEFAULT_WORKING_DAYS=22
PAYROLL_JURISDICTION=demo

# --- Development seed -------------------------------------------------------
# Password for the seeded demo accounts. The seed refuses to run with the
# default value when APP_ENV=production.
PAYLENS_SEED_PASSWORD=PayLens#Demo2026
